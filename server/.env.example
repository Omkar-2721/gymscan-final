# Razorpay TEST MODE API Keys
# Get yours at: https://dashboard.razorpay.com/ -> Account & Settings -> API Keys (Switch to Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Gemini API (Optional Primary Vision-LLM Label Extractor — Free key from https://aistudio.google.com/apikey)
# Leave blank to run 100% offline using Tesseract.js OCR fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Express & ML Service Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
ML_SERVICE_URL=http://127.0.0.1:8000
